{
  "name": "5c-dining",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "fuse.js": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.131.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:clear": "expo start --web --clear",
    "export:web": "expo export --platform web && node scripts/flatten-export-assets.mjs",
    "test:export-assets": "node --test scripts/flatten-export-assets.test.mjs",
    "test:day-pill-layout": "node --test scripts/day-pill-layout.test.mjs",
    "test:deploy-preview": "node --test scripts/deploy-preview.test.mjs",
    "serve:web": "npx serve dist",
    "deploy": "npm run export:web && wrangler deploy",
    "deploy:preview": "npm run export:web && node scripts/deploy-preview.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "private": true
}
